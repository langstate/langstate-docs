{
  "name": "langstate-site",
  "private": true,
  "scripts": {
    "dev:docs": "bash scripts/run-docs-dev.sh",
    "dev:ports:show": "bash scripts/show-dev-ports.sh",
    "dev:ports:reset": "bash scripts/reset-dev-ports.sh",
    "check:docs": "bash scripts/run-docs-check.sh",
    "validate:docs:deploy": "bash scripts/run-docs-deploy-check.sh",
    "dev:homepage": "bash scripts/run-homepage-dev.sh",
    "build:homepage": "pnpm --filter @langstate/homepage build",
    "deploy:homepage:preview": "vercel deploy apps/homepage -y",
    "start:homepage": "pnpm --filter @langstate/homepage start",
    "docker:up": "docker compose up --build",
    "docker:up:docs": "docker compose up --build docs",
    "docker:up:homepage": "docker compose up --build homepage",
    "docker:down": "docker compose down"
  }
}
